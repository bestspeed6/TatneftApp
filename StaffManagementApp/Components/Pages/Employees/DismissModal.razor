@inject ICareerService CareerService

<div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-door-open-fill me-2"></i>Увольнение сотрудника</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="OnCancel"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger d-flex align-items-center mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2 flex-shrink-0"></i>
                        <div>@_error</div>
                    </div>
                }
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Это действие оформит увольнение сотрудника. Данные сохранятся в истории.
                </div>
                <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Дата увольнения *</label>
                        <InputDate class="form-control" @bind-Value="_model.DismissDate" />
                        @if (CurrentEventDate.HasValue)
                        {
                            <small class="text-muted">Не ранее @CurrentEventDate.Value.ToLocalTime().ToString("dd.MM.yyyy"), не позднее сегодня</small>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Основание / комментарий</label>
                        <InputTextArea class="form-control" @bind-Value="_model.Comment" rows="3"
                                       placeholder="Например: По собственному желанию" />
                    </div>

                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-secondary" @onclick="OnCancel">Отмена</button>
                        <button type="submit" class="btn btn-danger" disabled="@_saving">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Уволить
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int EmployeeId { get; set; }
    /// <summary>Дата последнего кадрового события (для подсказки минимальной даты).</summary>
    [Parameter] public DateTime? CurrentEventDate { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private DismissFormModel _model = new() { DismissDate = DateTime.Today };
    private bool _saving;
    private string? _error;

    private async Task HandleSubmit()
    {
        _saving = true;
        _error = null;
        try
        {
            await CareerService.DismissAsync(EmployeeId, _model.DismissDate, _model.Comment);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _saving = false;
    }

    private class DismissFormModel
    {
        public DateTime DismissDate { get; set; } = DateTime.Today;
        public string? Comment { get; set; }
    }
}
