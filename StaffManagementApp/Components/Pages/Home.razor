@page "/"

<PageTitle>Управление персоналом</PageTitle>

<div class="text-center py-5">
    <h1 class="display-4">🏢 Система управления персоналом</h1>
    <p class="lead text-muted">ПАО «Татнефть»</p>
    <hr class="my-4" />
    <div class="row justify-content-center g-4 mt-2">
        <div class="col-md-3">
            <a href="/departments" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-4 hover-card">
                    <div class="fs-1">🏢</div>
                    <h5 class="mt-2">Подразделения</h5>
                    <p class="text-muted small">Управление структурой организации</p>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/employees" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-4">
                    <div class="fs-1">👥</div>
                    <h5 class="mt-2">Сотрудники</h5>
                    <p class="text-muted small">Кадровый учёт и личные карточки</p>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/reports" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-4">
                    <div class="fs-1">📊</div>
                    <h5 class="mt-2">Отчёты</h5>
                    <p class="text-muted small">Кадровые движения за период</p>
                </div>
            </a>
        </div>
    </div>
</div>
